# Скопируйте в backend/.env и вставьте ключи. Файл .env не попадает в git.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# APP_NAME=Olymp Trainer
# LLM_CHAIN=gemini:gemini-3.5-flash,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free

# Claude API: чат, импорт задач, проверка ответов
OLYMP_ANTHROPIC_API_KEY=
IMPORT_MODEL=anthropic:claude-haiku-5-5

# Sonnet в чате — только когда Haiku не справляется. Лимиты запросов к нему в день:
# STRONG_PER_USER_DAILY=5
# STRONG_GLOBAL_DAILY=150

# Защита бюджета и от злоупотреблений
# AI_GLOBAL_DAILY_LIMIT=3000      # запросов к ИИ в день на весь сервер
# SIGNUPS_PER_IP_HOUR=40          # новых аккаунтов в час с одного адреса
# SANDBOX_MAX_PARALLEL=4          # одновременных запусков песочницы для кода
# TRUST_PROXY=1                   # включить за прокси (Render), чтобы IP брался из X-Forwarded-For
